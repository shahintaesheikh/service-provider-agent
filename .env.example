# --- API Keys ---

# OpenAI — used by ChatOpenAI for NLU / entity extraction
OPENAI_API_KEY=sk-...

# TypeSafe AI — Jev System One for typed, calibrated decisions
# See https://docs.typesafe.ai/ for API documentation
TYPESAFE_API_KEY=ts_...

# Google Places API — provider search by category + location
GOOGLE_PLACES_API_KEY=...

# --- Optional ---

# Yelp Fusion API — cross-reference reviews and ratings (free tier)
YELP_API_KEY=...

# Default model override for Jev (optional)
# TYPESAFE_DEFAULT_MODEL=...