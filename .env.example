# --- API Keys ---

# OpenAI — used by ChatOpenAI for NLU / entity extraction
OPENAI_API_KEY=sk-...

# TypeSafe AI — Jev System One for typed, calibrated decisions
# See https://docs.typesafe.ai/ for API documentation
TYPESAFE_API_KEY=ts_...

# Google Places API (New) — provider search by category + location
# 1. Create a Google Cloud project: https://console.cloud.google.com
# 2. Enable the Places API (New) under "Google Maps Platform"
# 3. Create an API key from the Credentials page
#    (You can start prototyping with a Maps Demo Key at
#     https://mapsplatform.google.com — no credit card needed)
# 4. Set the key below:
GOOGLE_API_KEY=AIzaSy...

# --- Optional ---

# Yelp Fusion API — cross-reference reviews and ratings (free tier)
YELP_API_KEY=...

# Default model override for Jev (optional)
# TYPESAFE_DEFAULT_MODEL=...
